{
  "name": "excalicursor",
  "version": "1.0.0",
  "description": "Native macOS screen-annotation & Excalidraw overlay utility",
  "os": [
    "darwin"
  ],
  "bin": {
    "excalicursor": "./bin/excalicursor.js"
  },
  "scripts": {
